<?xml version="1.0" encoding="utf-8"?>
<interface>
    <template class="JellyTuneDownloadProgressAlert">
        <property name="heading" translatable="yes">Active downloads</property>
        <property name="body">There are active downloads in the background. Closing application will cancel all active downloads. Are you sure you want to close application?</property>
        <property name="default-response">cancel</property>
        <property name="close-response">close</property>
        <responses>
            <response id="cancel" translatable="yes">Cancel</response>
            <response id="close" translatable="yes" appearance="destructive">Close</response>
        </responses>
    </template>
</interface>