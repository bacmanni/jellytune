<?xml version="1.0" encoding="utf-8"?>
<interface>
    <template class="JellyTunePreferencesAlert">
        <property name="heading" translatable="yes">Problem with server and account</property>
        <property name="body" translatable="yes">Connection has not been updated. Click close to continue without saving.</property>
        <property name="default-response">cancel</property>
        <property name="close-response">close</property>
        <responses>
            <response id="cancel" translatable="yes">Cancel</response>
            <response id="close" translatable="yes" appearance="destructive">Close</response>
        </responses>
    </template>
</interface>