<?xml version="1.0" encoding="utf-8"?>
<interface>
    <template class="JellyTuneSwipeRow">
        <property name="overflow">hidden</property>
        <style>
            <class name="swipe-row"/>
        </style>
        <child>
            <object class="GtkOverlay" id="_overlay">
                <child>
                    <object class="GtkBox" id="_foregroundBox">
                        <property name="hexpand">true</property>
                        <property name="vexpand">true</property>
                        <property name="halign">fill</property>
                        <property name="valign">fill</property>
                        <child>
                            <object class="GtkBox" id="_foregroundContent">
                                <property name="hexpand">true</property>
                                <property name="vexpand">true</property>
                                <property name="halign">fill</property>
                                <property name="valign">fill</property>
                            </object>
                        </child>
                    </object>
                </child>
                <child type="overlay">
                    <object class="GtkBox" id="_leftBox">
                        <property name="hexpand">true</property>
                        <property name="halign">center</property>
                        <property name="valign">center</property>
                        <child>
                            <object class="GtkLabel" id="_leftLabel">
                                <property name="margin-start">8</property>
                                <property name="ellipsize">3</property>
                                <property name="halign">1</property>
                                <style>
                                    <class name="title-4"/>
                                </style>
                            </object>
                        </child>
                    </object>
                </child>
                <child type="overlay">
                    <object class="GtkBox" id="_rightBox">
                        <property name="hexpand">true</property>
                        <property name="halign">center</property>
                        <property name="valign">center</property>
                        <child>
                            <object class="GtkLabel" id="_rightLabel">
                                <property name="margin-end">8</property>
                                <property name="ellipsize">3</property>
                                <property name="halign">1</property>
                                <style>
                                    <class name="title-4"/>
                                </style>
                            </object>
                        </child>
                    </object>
                </child>
            </object>
        </child>
    </template>
</interface>
